up-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"durability\">Durability</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"size\">Size</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"durability\">500</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"size\">10x3</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Damaged by <a href=\"/wiki/Rain\" class=\"mw-redirect\" title=\"Rain\">Rain</a>?</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">No</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Storage Width</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Storage Height</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Storage Slots</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">2</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">2</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">4</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Crafting Materials</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li><a href=\"/wiki/Finewood\" title=\"Finewood\">Finewood</a> x30</li><li><a href=\"/wiki/Deer_hide\" class=\"mw-redirect\" title=\"Deer hide\">Deer hide</a> x10</li><li><a href=\"/wiki/Resin\" title=\"Resin\">Resin</a> x20</li><li><a href=\"/wiki/Bronze_nails\" class=\"mw-redirect\" title=\"Bronze nails\">Bronze nails</a> x80</li></ul></div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Resistances</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x1.5\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Weak to</span></span></div><div class=\"mw-collapsible-content\"> (x1.5)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Fire\" title=\"Damage\">Fire</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x1\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Neutral to</span></span></div><div class=\"mw-collapsible-content\"> (x1)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Blunt\" title=\"Damage\">Blunt</a>, <a href=\"/wiki/Damage#Slash\" title=\"Damage\">Slash</a>, <a href=\"/wiki/Damage#Lightning\" title=\"Damage\">Lightning</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x0.5\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Resistant to</span></span></div><div class=\"mw-collapsible-content\"> (x0.5)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Pierce\" title=\"Damage\">Pierce</a>, <a href=\"/wiki/Damage#Frost\" title=\"Damage\">Frost</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x0\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Immune to</span></span></div><div class=\"mw-collapsible-content\"> (x0)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Chop\" title=\"Damage\">Chop</a>, <a href=\"/wiki/Damage#Pickaxe\" title=\"Damage\">Pickaxe</a>, <a href=\"/wiki/Damage#Poison\" title=\"Damage\">Poison</a>, <a href=\"/wiki/Damage#Spirit\" title=\"Damage\">Spirit</a></div>\n</div>\n\n</section>\n</aside>\n\n<b>Karves</b> are medium <a href=\"/wiki/Boats\" title=\"Boats\">boats</a> with a medium sailing speed, a small amount of storage and good maneuverability. Their moderate cost of construction along with slightly higher health and significantly faster sailing speeds than the Raft make the Karve the first reliable boat for longer ocean voyages. Care should still be taken, since its health makes the Karve deceptively fragile when set upon by <a href=\"/wiki/Serpent\" title=\"Serpent\">Serpents</a>.\n<p class=\"mw-empty-elt\"></p><p>They travel 3.9–7.0 m/s with full sails, 2.8–4.8 m/s with half sails and 3.14 m/s when paddling.\n</p>\n<h2><span class=\"mw-headline\" id=\"Specifications\">Specifications</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FKarve%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>500 HP</li>\n<li>10m long x 3m wide x 8m air draft (height from waterline).</li>\n<li>2 seats plus pilot (currently any number of people can hold fast)</li>\n<li>4 storage slots (cargo weight does not seem to affect handling or speed)</li>\n<li>Speeds\n<ul><li>Full sails:\n<ul><li>100% wind: 7.0 m/s, high risk of capsizing</li>\n<li>50% wind: 5.7 m/s</li>\n<li>5% wind: 3.9 m/s</li></ul></li>\n<li>Half sails:\n<ul><li>100% wind: 4.8 m/s</li>\n<li>50% wind: 4.1 m/s</li>\n<li>5% wind: 2.8 m/s</li></ul></li>\n<li>Paddling: 3.14 m/s</li></ul></li>\n<li>20m turning radius at top speed with full sail</li></ul>\n<h2><span class=\"mw-headline\" id=\"Notes\">Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FKarve%3Fveaction%3Dedit%26section%3D2&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Boats cannot be deconstructed with a hammer, but their resources drop when they are destroyed and can be recovered if a player is standing or swimming in range to pick them up before they sink.</li>\n<li>The Karve can outrun a <a href=\"/wiki/Serpent\" title=\"Serpent\">Serpent</a> with the wind directly behind it during a thunderstorm; eventually, the Serpent will give up the chase.</li>\n<li>Karves can capsize from heavy waves during storms, though it is rare. Sail directly towards the waves at less than full sails to minimize the risk.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FKarve%3Fveaction%3Dedit%26section%3D3&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div id=\"gallery-0\" hash=\"1f2f4ab5e66ee54e1b4442012719b08c\" data-seq-no=\"0\" class=\"wikia-gallery wikia-gallery-caption-below wikia-gallery-position-left wikia-gallery-spacing-medium wikia-gallery-border-small wikia-gallery-captions-left wikia-gallery-caption-size-medium\"><div class=\"wikia-gallery-caption\"></div><div class=\"wikia-gallery-item\" style=\"width:187px; \"><div class=\"thumb\" style=\"height:133px;\"><div class=\"gallery-image-wrapper accent\" id=\"Karve_in_storm-png\" style=\"position: relative; height:104px; width:185px; top:13.5px;\"><a class=\"image lightbox\" href=\"/wiki/File:Karve_in_storm.png\" title=\"Karve in storm.png (1.52 MB)\" style=\"height:104px; width:185px;\"><noscript><img style=\"\" src=\"https://static.wikia.nocookie.net/valheim/images/6/60/Karve_in_storm.png/revision/latest/scale-to-width-down/185?cb=20210915123843\" title=\"Karve in storm.png (1.52 MB)\" class=\"thumbimage\" alt=\"Karve in a storm\" height=\"131\" width=\"185\" data-image-name=\"Karve in storm.png\" data-image-key=\"Karve_in_storm.png\" data-relevant=\"1\" data-caption=\"Karve in a storm\"></noscript><img style=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" title=\"Karve in storm.png (1.52 MB)\" class=\"thumbimage lazyload\" alt=\"Karve in a storm\" height=\"131\" width=\"185\" data-image-name=\"Karve in storm.png\" data-image-key=\"Karve_in_storm.png\" data-relevant=\"1\" data-caption=\"Karve in a storm\" data-src=\"https://static.wikia.nocookie.net/valheim/images/6/60/Karve_in_storm.png/revision/latest/scale-to-width-down/185?cb=20210915123843\" /></a></div></div><div class=\"lightbox-caption\" style=\"width:185px;\">Karve in a storm</div></div><div class=\"wikia-gallery-item\" style=\"width:187px; \"><div class=\"thumb\" style=\"height:133px;\"><div class=\"gallery-image-wrapper accent\" id=\"Sailing_Boat_Karve-png\" style=\"position: relative; height:131px; width:185px;\"><a class=\"image lightbox\" href=\"/wiki/File:Sailing_Boat_Karve.png\" title=\"Sailing Boat Karve.png (402 KB)\" style=\"height:131px; width:185px;\"><noscript><img style=\"\" src=\"https://static.wikia.nocookie.net/valheim/images/3/36/Sailing_Boat_Karve.png/revision/latest/scale-to-width-down/185?cb=20210212172451\" title=\"Sailing Boat Karve.png (