data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Mead</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Internal ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">MeadBugRepellent</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"source\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Source</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Fermenter\" title=\"Fermenter\">Fermenter</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usage\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Usage</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Drinking</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Properties</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Weight</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"stack\">Stack</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">1.0</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"stack\">10</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"teleport\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"Can go through wood portal?\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Teleportable</span></span></div><div class=\"mw-collapsible-content\"> (Can go through wood portal?)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Yes</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Crafting Materials</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><b>Crafts 6</b><ul><li><a href=\"/wiki/Mead_base:_Anti-sting\" class=\"mw-redirect\" title=\"Mead base: Anti-sting\">Mead base: Anti-sting</a> x1</li></ul></div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Effects</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"duration\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Duration</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span style=\"cursor: help; border-bottom: 2px dotted var(--theme-accent-color);\" title=\"600s\">10m</span></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"cooldown\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Cooldown</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span style=\"cursor: help; border-bottom: 2px dotted var(--theme-accent-color);\" title=\"0s\">0s</span></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"effect\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Other Effect(s)</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li>Prevent <a href=\"/wiki/Deathsquito\" title=\"Deathsquito\">Deathsquito</a> attacks</li></ul></div>\n</div>\n\n</section>\n</aside>\n<p class=\"mw-empty-elt\"></p></div><div class=\"wds-tab__content\"><p class=\"mw-empty-elt\">\n\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-default\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Anti-Sting Concoction</h2>\n\n<figure class=\"pi-item pi-image\" data-source=\"image\">\n\t<a href=\"https://static.wikia.nocookie.net/valheim/images/3/30/Mead_Base_-_Anti-Sting.png/revision/latest?cb=20241108233413\" class=\"image image-thumbnail\" title=\"Mead base: Anti-sting\">\n\t\t<img src=\"https://static.wikia.nocookie.net/valheim/images/3/30/Mead_Base_-_Anti-Sting.png/revision/latest?cb=20241108233413\" srcset=\"https://static.wikia.nocookie.net/valheim/images/3/30/Mead_Base_-_Anti-Sting.png/revision/latest?cb=20241108233413 1x, https://static.wikia.nocookie.net/valheim/images/3/30/Mead_Base_-_Anti-Sting.png/revision/latest?cb=20241108233413 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Mead base: Anti-sting\" width=\"64\" height=\"64\" data-image-key=\"Mead_base%3A_Anti-sting.png\" data-image-name=\"Mead base: Anti-sting.png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t<div class=\"pi-data-value pi-font\"><i>Needs to be fermented.</i></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Mead Base</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Internal ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">MeadBaseBugRepellent</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"source\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Source</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Mead_ketill\" class=\"mw-redirect\" title=\"Mead ketill\">Mead ketill</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usage\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Usage</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Fermenter\" title=\"Fermenter\">Fermenter</a></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Properties</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Weight</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"stack\">Stack</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">1.0</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"stack\">1</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"teleport\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"Can go through wood portal?\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Teleportable</span></span></div><div class=\"mw-collapsible-content\"> (Can go through wood portal?)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Yes</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Crafting Materials</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li><a href=\"/wiki/Cloudberries\" title=\"Cloudberries\">Cloudberries</a> x10</li><li><a href=\"/wiki/Grouper\" title=\"Grouper\">Grouper</a> x3</li><li><a href=\"/wiki/Fragrant_bundle\" class=\"mw-redirect\" title=\"Fragrant bundle\">Fragrant bundle</a> x1</li></ul></div>\n</div>\n\n</section>\n</aside>\n<p class=\"mw-empty-elt\"></p></div></div></div>\n<p><b>Anti-sting concoction</b> is a <a href=\"/wiki/Plains\" title=\"Plains\">Plains</a>-tier consumable item <a href=\"/wiki/Fermenter\" title=\"Fermenter\">fermented</a> from <b>Mead base: Anti-sting</b>.\n</p>\n<h2><span class=\"mw-headline\" id=\"Recipe\">Recipe</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FAnti-Sting_Concoction%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><i>Mead base: Anti-sting</i> is produced in a <a href=\"/wiki/Mead_ketill\" class=\"mw-redirect\" title=\"Mead ketill\">Mead ketill</a> with:\n</p>\n<ul><li><span typeof=\"mw:File\"><a href=\"/wiki/Cloudberries\" title=\"Cloudberries\"><img alt=\"Cloudberries\" src=\"https://static.wikia.nocookie.net/valheim/images/e/e4/Cloudberries.png/revision/latest/scale-to-width-down/30?cb=20210215131511\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Cloudberries.png\" data-image-key=\"Cloudberries.png\" data-relevant=\"0\" /></a></span>&#160;10&#160;<a href=\"/wiki/Cloudberries\" title=\"Cloudberries\">Cloudberries</a></li>\n<li><span typeof=\"mw:File\"><a href=\"/wiki/Grouper\" title=\"Grouper\"><img alt=\"Grouper\" src=\"https://static.wikia.nocookie.net/valheim/images/c/c4/Grouper.png/revision/latest/scale-to-width-down/30?cb=20221130103545\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Grouper.png\" data-image-key=\"Grouper.png\" data-relevant=\"0\" /></a></span>&#160;3&#160;<a href=\"/wiki/Grouper\" title=\"Grouper\">Grouper</a></li>\n<li><span typeof=\"mw:File\"><a href=\"/wiki/Fragrant_bundle\" title=\"Fragrant bundle\"><img alt=\"Fragrant Bundle\" src=\"https://static.wikia.nocookie.net/valheim/images/3/31/Fragrant_Bundle.png/revision/latest/scale-to-width-down/30?cb=20241016174105\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Fragrant Bundle.png\" data-image-key=\"Fragrant_Bundle.png\" data-relevant=\"0\" /></a></span>&#160;1&#160;<a href=\"/wiki/Fragrant_bundle\" class=\"mw-redirect\" title=\"Fragrant bundle\">Fragrant bundle</a></li></ul>\n<p>Six <i>Anti-sting concoctions</i> are produced by <a href=\"/wiki/Fermenter\" title=\"Fermenter\">fermenting</a> the mead base for two in-game <a href=\"/wiki/Day_and_Night_Cycle\" class=\"mw-redirect\" title=\"Day and Night Cycle\">days</a>.\n</p>\n<h2><span class=\"mw-headline\" id=\"Effect\">Effect</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FAnti-Sting_Concoction%3Fveaction%3Dedit%26section%3D2&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>Consuming it grants protection against <a href=\"/wiki/Deathsquito\" title=\"Deathsquito\">Deathsquitoes</a>. They will still approach the player, but will flee three to eight meters away instead of attacking.\n</p>\n<table class=\"navbox mw-collapsible mw-collapsed\" data-expandtext=\"Show\" data-collapsetext=\"Hide\"><tbody><tr class=\"navbox-title\"><th colspan=\"2\" scope=\"col\"><span class=\"navbox-vde\"><a href=\"/wiki/Template:FoodsNav\" title=\"Template:FoodsNav\"><span title=\"View this navbox template\">v</span></a> · <span class=\"plainlinks\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://valheim.fandom.com/wiki/Template_talk:FoodsNav\"><span title=\"Discuss this navbox template\">d</span></a> · <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://valheim.fandom.com/wiki/Template:FoodsNav?action=edit\"><span title=\"Edit this navbox template\">e</span></a></span></span><div class=\"navbox-title-pad navbox-title-padleft navbox-title-padright\"><a href=\"/wiki/Food\" title=\"Food\">Food</a> and <a href=\"/wiki/Mead\" title=\"Mead\">meads</a></div></th></tr><tr class=\"navbox-gutter\"><td colspan=\"2\"></td></tr><tr class=\"navbox-row\"><th class=\"navbox-group\" scope=\"row\"><a href=\"/wiki/Food\" title=\"Food\">Food</a></th><td class=\"navbox-list\" style=\"background: none\"><div class=\"hlist\"></div><table class=\"navbox-subgroup\"><tbody><tr class=\"navbox-row\"><th class=\"navbox-group\" scope=\"row\"><a href=\"/wiki/Meadows\" title=\"Meadows\">Meadows</a></th><td class=\"navbox-list\" style=\"background: none\"><div class=\"hlist\"></div><table class=\"navbox-subgroup\"><tbody><tr class=\"navbox-row\"><th class=\"navbox-group\" scope=\"row\">Health</th><td class=\"navbox-list\"><div class=\"hlist\"><a 