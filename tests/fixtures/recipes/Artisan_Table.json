okie.net/valheim/images/5/5b/Artisan_table_appearance.png/revision/latest?cb=20241207111518\" class=\"image image-thumbnail\" title=\"Artisan table appearance\">\n\t\t<img src=\"https://static.wikia.nocookie.net/valheim/images/5/5b/Artisan_table_appearance.png/revision/latest/scale-to-width-down/268?cb=20241207111518\" srcset=\"https://static.wikia.nocookie.net/valheim/images/5/5b/Artisan_table_appearance.png/revision/latest/scale-to-width-down/268?cb=20241207111518 1x, https://static.wikia.nocookie.net/valheim/images/5/5b/Artisan_table_appearance.png/revision/latest/scale-to-width-down/535?cb=20241207111518 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Artisan table appearance\" width=\"270\" height=\"212\" data-image-key=\"Artisan_table_appearance.png\" data-image-name=\"Artisan table appearance.png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t<div class=\"pi-data-value pi-font\"><i>Crafting station</i></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Crafting</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"skill\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Skill</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Crafting</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Internal ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">piece_artisanstation</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Crafting Station</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Max Level</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">2</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Improvements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Artisan_press\" class=\"mw-redirect\" title=\"Artisan press\">Artisan press</a></div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Properties</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"durability\">Durability</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"size\">Size</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"durability\">200</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"size\">2.8 x 2.6 x 1.9</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Damaged by <a href=\"/wiki/Rain\" class=\"mw-redirect\" title=\"Rain\">Rain</a>?</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">Yes</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Crafting Materials</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li><a href=\"/wiki/Dragon_tear\" class=\"mw-redirect\" title=\"Dragon tear\">Dragon tear</a> x2</li><li><a href=\"/wiki/Wood\" title=\"Wood\">Wood</a> x10</li></ul></div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Resistances</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x1.5\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Weak to</span></span></div><div class=\"mw-collapsible-content\"> (x1.5)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Chop\" title=\"Damage\">Chop</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x1\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Neutral to</span></span></div><div class=\"mw-collapsible-content\"> (x1)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Blunt\" title=\"Damage\">Blunt</a>, <a href=\"/wiki/Damage#Slash\" title=\"Damage\">Slash</a>, <a href=\"/wiki/Damage#Pickaxe\" title=\"Damage\">Pickaxe</a>, <a href=\"/wiki/Damage#Fire\" title=\"Damage\">Fire</a>, <a href=\"/wiki/Damage#Frost\" title=\"Damage\">Frost</a>, <a href=\"/wiki/Damage#Lightning\" title=\"Damage\">Lightning</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x0.5\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Resistant to</span></span></div><div class=\"mw-collapsible-content\"> (x0.5)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Pierce\" title=\"Damage\">Pierce</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x0\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Immune to</span></span></div><div class=\"mw-collapsible-content\"> (x0)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Poison\" title=\"Damage\">Poison</a>, <a href=\"/wiki/Damage#Spirit\" title=\"Damage\">Spirit</a></div>\n</div>\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><b>Artisan Tables</b> are <a href=\"/wiki/Player_base\" title=\"Player base\">base</a> structures used for building <a href=\"/wiki/Blast_furnace\" class=\"mw-redirect\" title=\"Blast furnace\">Blast furnaces</a>, <a href=\"/wiki/Spinning_wheel\" class=\"mw-redirect\" title=\"Spinning wheel\">Spinning wheels</a>, <a href=\"/wiki/Windmill\" title=\"Windmill\">Windmills</a>, and <a href=\"/wiki/Stone_oven\" class=\"mw-redirect\" title=\"Stone oven\">Stone oven</a> within 40 meters.\n</p><p>They require <a href=\"/wiki/Dragon_tear\" class=\"mw-redirect\" title=\"Dragon tear\">Dragon tears</a>, so they can only be built after killing <a href=\"/wiki/Moder\" title=\"Moder\">Moder</a>. Its upgrade is required to build the <a href=\"/wiki/Drakkar\" title=\"Drakkar\">Drakkar</a> to reach <a href=\"/wiki/Ashlands\" title=\"Ashlands\">Ashlands</a> and is obtained by killing <a href=\"/wiki/The_Queen\" title=\"The Queen\">The Queen</a>.\n</p><p>Interacting requires a roof and 70% <a href=\"/wiki/Cover\" title=\"Cover\">cover</a>. Building structures does not require roof or any cover.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Upgrades\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Upgrades</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Recipes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Recipes</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-3\"><a href=\"#Level_1_(base)\"><span class=\"tocnumber\">2.1</span> <span class=\"toctext\">Level 1 (base)</span></a></li>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Level_2\"><span class=\"tocnumber\">2.2</span> <span class=\"toctext\">Level 2</span></a></li>\n</ul>\n</li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Upgrades\">Upgrades</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FArtisan_Table%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>Upgrading an Artisan Table enables additional crafting recipes. An Artisan table can be upgraded by building the following structures near it:\n</p>\n<table class=\"article-table sortable\">\n<tbody><tr>\n<th>Icon\n</th>\n<th>Name\n</th>\n<th>Materials\n</th></tr>\n<tr>\n<td><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/valheim/images/e/ea/Artisan_Press.png/revision/latest?cb=20240423192031\" class=\"mw-file-description image\"><img alt=\"Artisan Press\" src=\"https://static.wikia.nocookie.net/valheim/images/e/ea/Artisan_Press.png/revision/latest?cb=20240423192031\" decoding=\"async\" loading=\"lazy\" width=\"64\" height=\"64\" class=\"mw-file-element\" data-image-name=\"Artisan Press.png\" data-image-key=\"Artisan_Press.png\" data-relevant=\"0\" /></a></span>\n</td>\n<td>Artisan Press\n</td>\n<td>\n<p>5 <a href=\"/wiki/Black_marble\" class=\"mw-redirect\" title=\"Black marble\">Black marble</a><br />5 <a href=\"/wiki/Bronze\" title=\"Bronze\">Bronze</a><br />1 <a href=\"/wiki/Majestic_carapace\" class=\"mw-redirect\" title=\"Majestic carapace\">Majestic carapace</a>\n</p>\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Recipes\">Recipes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FArtisan_Table%3Fveaction%3Dedit%26section%3D2&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h3><span id=\"Level_1_.28base.29\"></span><span class=\"mw-headline\" id=\"Level_1_(base)\">Level 1 (base)</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FArtisan_Table%3Fveaction%3Dedit%26section%3D3&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<ul><li><span typeof=\"mw:File\"><a href=\"/wiki/Wooden_missile\" title=\"Wooden missile\"><img alt=\"Wooden Missile\" src=\"https://static.wikia.nocookie.net/valheim/images/7/7b/Wooden_Missile.png/revision/latest/scale-to-width-down/30?cb=20221126160541\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Wooden Missile.png\" data-image-key=\"Wooden_Missile.png\" data-relevant=\"0\" /></a></span>&#160;<a href=\"/wiki/Wooden_missile\" class=\"mw-redirect\" title=\"Wooden missile\">Wooden missile</a></li>\n<li><span typeof=\"mw:File\"><a href=\"/wiki/Black_metal_missile\" title=\"Black metal missile\"><img alt=\"Black Metal Missile\" src=\"https://static.wikia.nocookie.net/valheim/images/b/b3/Black_Metal_Missile.png/revision/latest/scale-to-width-down/30?cb=20221126160608\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Black Metal Missile.png\" data-image-key=\"Black_Metal_Missile.png\" data-relevant=\"0\" /></a></span>&#160;<a href=\"/wiki/Black_metal_missile\" class=\"m