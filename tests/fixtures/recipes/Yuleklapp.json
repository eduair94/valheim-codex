ass=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usage\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Usage</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Decoration, <a href=\"/wiki/Storage\" title=\"Storage\">Storage</a></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Properties</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"durability\">Durability</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"size\">Size</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"durability\">10</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"size\">0.6 x 0.35 x 0.4 (small)<br /><p>0.75 x 0.4 x 0.5 (medium)<br />0.9 x 0.5 x 0.6 (large)</p></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Damaged by <a href=\"/wiki/Rain\" class=\"mw-redirect\" title=\"Rain\">Rain</a>?</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">No</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Storage Width</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Storage Height</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Storage Slots</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">1 (small)<br />2 (medium)<br />3 (large)</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">1</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">1x1 (small)<br />2x1 (medium)<br />3x1 (large)</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Crafting Materials</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Small:<ul><li><a href=\"/wiki/Finewood\" title=\"Finewood\">Finewood</a> x2</li><li><a href=\"/wiki/Bone_fragments\" class=\"mw-redirect\" title=\"Bone fragments\">Bone fragments</a> x1</li></ul><p>Medium:</p><ul><li><a href=\"/wiki/Finewood\" title=\"Finewood\">Finewood</a> x3</li><li><a href=\"/wiki/Dandelion\" title=\"Dandelion\">Dandelion</a> x1</li></ul><p>Large:</p><ul><li><a href=\"/wiki/Finewood\" title=\"Finewood\">Finewood</a> x4</li><li><a href=\"/wiki/Raspberries\" title=\"Raspberries\">Raspberries</a> x1</li></ul></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"support\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><a href=\"/wiki/Building_Stability\" class=\"mw-redirect\" title=\"Building Stability\">Support</a></h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Wood (from 10 to 100)</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"support\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><a href=\"/wiki/Building_Stability\" class=\"mw-redirect\" title=\"Building Stability\">Loss</a></h3>\n\t\n\t<div class=\"pi-data-value pi-font\">1/8 vertical, 1/5 horizontal</div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Resistances</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x1\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Neutral to</span></span></div><div class=\"mw-collapsible-content\"> (x1)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Lightning\" title=\"Damage\">Lightning</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x0.5\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Resistant to</span></span></div><div class=\"mw-collapsible-content\"> (x0.5)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Blunt\" title=\"Damage\">Blunt</a>, <a href=\"/wiki/Damage#Slash\" title=\"Damage\">Slash</a>, <a href=\"/wiki/Damage#Pierce\" title=\"Damage\">Pierce</a>, <a href=\"/wiki/Damage#Chop\" title=\"Damage\">Chop</a>, <a href=\"/wiki/Damage#Pickaxe\" title=\"Damage\">Pickaxe</a>, <a href=\"/wiki/Damage#Fire\" title=\"Damage\">Fire</a>, <a href=\"/wiki/Damage#Frost\" title=\"Damage\">Frost</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"x0\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Immune to</span></span></div><div class=\"mw-collapsible-content\"> (x0)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Damage#Poison\" title=\"Damage\">Poison</a>, <a href=\"/wiki/Damage#Spirit\" title=\"Damage\">Spirit</a></div>\n</div>\n\n</section>\n</aside>\n\nA <b>Yuleklapp</b> is a <a href=\"/wiki/Seasonal_events\" title=\"Seasonal events\">seasonal</a> buildable structure which has item slots, for storing items inside. It needs to be built within the range of a <a href=\"/wiki/Workbench\" title=\"Workbench\">Workbench</a>.\n<p class=\"mw-empty-elt\"></p><p>It comes in small, medium and large variants with 1, 2 and 3 slots, respectively.\n</p>\n<h2><span class=\"mw-headline\" id=\"Availability\">Availability</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FYuleklapp%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>Yuleklapp cannot be built year-round. It can only be built during the Christmas season, <span class=\"mw-formatted-date\" title=\"12-01\">1 December</span> – <span class=\"mw-formatted-date\" title=\"01-06\">6 January</span>.\n</p><p><br />\n</p>\n<table class=\"navbox mw-collapsible mw-collapsed\" data-expandtext=\"Show\" data-collapsetext=\"Hide\"><tbody><tr class=\"navbox-title\"><th colspan=\"2\" scope=\"col\"><span class=\"navbox-vde\"><a href=\"/wiki/Template:BuildingNav\" title=\"Template:BuildingNav\"><span title=\"View this navbox template\">v</span></a> · <span class=\"plainlinks\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://valheim.fandom.com/wiki/Template_talk:BuildingNav\"><span title=\"Discuss this navbox template\">d</span></a> · <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://valheim.fandom.com/wiki/Template:BuildingNav?action=edit\"><span title=\"Edit this navbox template\">e</span></a></span></span><div class=\"navbox-title-pad navbox-title-padleft navbox-title-padright\"><a href=\"/wiki/Category:Building\" title=\"Category:Building\">Buildings</a></div></th></tr><tr class=\"navbox-gutter\"><td colspan=\"2\"></td></tr><tr class=\"navbox-row\"><th class=\"navbox-group\" scope=\"row\">Crafting</th><td class=\"navbox-list\" style=\"background: none\"><div class=\"hlist\"></div><table class=\"navbox-subgroup\"><tbody><tr class=\"navbox-row\"><th class=\"navbox-group\" scope=\"row\">Stations</th><td class=\"navbox-list\"><div class=\"hlist\"><a href=\"/wiki/Workbench\" title=\"Workbench\">Workbench</a> • <a href=\"/wiki/Forge\" title=\"Forge\">Forge</a> • <a href=\"/wiki/Stonecutter\" title=\"Stonecutter\">Stonecutter</a> • <a href=\"/wiki/Artisan_Table\" title=\"Artisan Table\">Artisan Table</a> • <a href=\"/wiki/Wisp_Fountain\" title=\"Wisp Fountain\">Wisp Fountain</a> • <a href=\"/wiki/Black_Forge\" title=\"Black Forge\">Black Forge</a> • <a href=\"/wiki/Galdr_Table\" title=\"Galdr Table\">Galdr Table</a></div></td></tr><tr class=\"navbox-gutter\"><td colspan=\"2\"></td></tr><tr class=\"navbox-row alt\"><th class=\"navbox-group\" scope=\"row\">Smelting</t