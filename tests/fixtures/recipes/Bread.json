-secondary-background\" data-source=\"title\">Bread dough</h2>\n\n<figure class=\"pi-item pi-image\" data-source=\"image\">\n\t<a href=\"https://static.wikia.nocookie.net/valheim/images/b/b2/Bread_dough.png/revision/latest?cb=20210926155940\" class=\"image image-thumbnail\" title=\"Bread dough\">\n\t\t<img src=\"https://static.wikia.nocookie.net/valheim/images/b/b2/Bread_dough.png/revision/latest?cb=20210926155940\" srcset=\"https://static.wikia.nocookie.net/valheim/images/b/b2/Bread_dough.png/revision/latest?cb=20210926155940 1x, https://static.wikia.nocookie.net/valheim/images/b/b2/Bread_dough.png/revision/latest?cb=20210926155940 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Bread dough\" width=\"64\" height=\"64\" data-image-key=\"Bread_dough.png\" data-image-name=\"Bread dough.png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t<div class=\"pi-data-value pi-font\"><i>Ready for the oven.</i></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Material</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Internal ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">BreadDough</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"source\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Source</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Food_preparation_table\" class=\"mw-redirect\" title=\"Food preparation table\">Food preparation table</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"usage\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Usage</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Crafting</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Properties</h2>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\">Weight</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"stack\">Stack</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\">0.5</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"stack\">20</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"teleport\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"mw-collapsible mw-collapsed\"><div class=\"mw-collapsible-toggle toccolours\" style=\"float: none;\"><span title=\"Can go through wood portal?\" style=\"cursor:pointer\"><span style=\"cursor: help; border-bottom:2px dotted var(--theme-accent-color)\">Teleportable</span></span></div><div class=\"mw-collapsible-content\"> (Can go through wood portal?)</div></div></h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Yes</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Crafting Materials</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><b>Crafts 2</b><ul><li><a href=\"/wiki/Barley_flour\" class=\"mw-redirect\" title=\"Barley flour\">Barley flour</a> x10</li></ul></div>\n</div>\n\n</section>\n</aside>\n<p class=\"mw-empty-elt\"></p></div></div>\n</div>\n<p><b>Bread</b> is a <a href=\"/wiki/Plains\" title=\"Plains\">Plains</a>-tier <a href=\"/wiki/Food\" title=\"Food\">food</a>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Recipe\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Recipe</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Usage\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Usage</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-3\"><a href=\"#Crafting\"><span class=\"tocnumber\">2.1</span> <span class=\"toctext\">Crafting</span></a>\n<ul>\n<li class=\"toclevel-3 tocsection-4\"><a href=\"#Bread_dough\"><span class=\"tocnumber\">2.1.1</span> <span class=\"toctext\">Bread dough</span></a></li>\n<li class=\"toclevel-3 tocsection-5\"><a href=\"#Bread\"><span class=\"tocnumber\">2.1.2</span> <span class=\"toctext\">Bread</span></a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Notes\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Notes</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Recipe\">Recipe</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FBread%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>2 Bread doughs are produced in a <a href=\"/wiki/Food_preparation_table\" class=\"mw-redirect\" title=\"Food preparation table\">Food preparation table</a> with:\n</p>\n<ul><li><span typeof=\"mw:File\"><a href=\"/wiki/Barley_flour\" title=\"Barley flour\"><img alt=\"Barley Flour\" src=\"https://static.wikia.nocookie.net/valheim/images/b/b8/Barley_Flour.png/revision/latest/scale-to-width-down/30?cb=20210215131340\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Barley Flour.png\" data-image-key=\"Barley_Flour.png\" data-relevant=\"0\" /></a></span>&#160;10&#160;<a href=\"/wiki/Barley_flour\" class=\"mw-redirect\" title=\"Barley flour\">Barley flour</a></li></ul>\n<p>Bread is produced by baking Bread dough in a <a href=\"/wiki/Stone_oven\" class=\"mw-redirect\" title=\"Stone oven\">Stone oven</a> for 50 seconds. If left in the oven for 100 seconds, it will burn and turn into <a href=\"/wiki/Coal\" title=\"Coal\">Coal</a>.\n</p>\n<h2><span class=\"mw-headline\" id=\"Usage\">Usage</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FBread%3Fveaction%3Dedit%26section%3D2&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h3><span class=\"mw-headline\" id=\"Crafting\">Crafting</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FBread%3Fveaction%3Dedit%26section%3D3&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<h4><span class=\"mw-headline\" id=\"Bread_dough\">Bread dough</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fvalheim.fandom.com%2Fwiki%2FBread%3Fveaction%3Dedit%26section%3D4&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h4>\n<ul><li><span typeof=\"mw:File\"><a href=\"/wiki/Uncooked_fish_n%27_bread\" title=\"Uncooked fish n&#39; bread\"><img alt=\"Uncooked Fish &#39;n&#39; Bread\" src=\"https://static.wikia.nocookie.net/valheim/images/3/3c/Uncooked_Fish_%27n%27_Bread.png/revision/latest/scale-to-width-down/30?cb=20221130101620\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Uncooked Fish &#39;n&#39; Bread.png\" data-image-key=\"Uncooked_Fish_%27n%27_Bread.png\" data-rel