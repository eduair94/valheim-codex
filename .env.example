# ---- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Embeddings ------------------------------------------------------------
# "gemini" (default) uses gemini-embedding-001. Note the free tier allows only
# 1,000 embedding requests per DAY, while indexing this wiki needs several
# thousand — a full ingest needs billing enabled.
# "local" runs multilingual-e5-base on the CPU instead: no key, no quota, and
# the same 768 dimensions, so no migration either. Switching providers forces a
# re-embed; the ingest handles that automatically and refuses to mix vectors.
EMBEDDING_PROVIDER=local

# ---- Database --------------------------------------------------------------
# Production: Neon Postgres connection string (must have the `vector` extension).
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
# Leave empty to fall back to an embedded PGlite database under .data/ (local dev).
DATABASE_URL=

# Overrides the embedded database location (defaults to .data/pglite).
# The app uses DATABASE_URL whenever it is set and ignores this; blank
# DATABASE_URL to serve a local copy. Scripts refuse to run when this and
# DATABASE_URL (here or in .env.local) are both set: pass --pglite <dir> or --neon.
PGLITE_DATA_DIR=

# ---- Auth ------------------------------------------------------------------
# The shared password: its holders chat on the operator's model budget. Each
# one types a profile name at sign-in, which labels their history and guards
# nothing: anyone with the password who types the same name can read, rename
# and delete that history.
# Generate with: pnpm auth:hash "your-password"   (12 characters or more)
APP_PASSWORD_HASH=
# At least 32 characters; a shorter secret is refused and password sign-in stays off.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Readers without the password may chat on their own account instead:
#   byok   their own Gemini API key, kept encrypted in their browser's cookie
#   puter  their Puter account; the model runs from their browser, billed to them
# Comma-separated; "none" turns both off. Default: byok,puter
GUEST_CHAT_MODES=byok,puter
# Recommended: 32 random bytes (base64url) that encrypt the Gemini-key cookies.
# Without it a key is derived from SESSION_SECRET, so rotating SESSION_SECRET
# also forgets every stored Gemini key and cuts each Gemini-key reader off from
# their history: they start an empty one when they enter their key again.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BYOK_SECRET=
# Public origin(s) of this deployment, comma-separated. Puter sign-in accepts
# only tokens Puter issued to these origins. Default: https://valheim.digitalshopuy.com
APP_ORIGIN=
# Optional: pin the Puter app uid(s) (app-<uuid>) your origin maps to.
PUTER_APP_UIDS=
# Optional: the password profiles that may start a re-index (comma-separated).
# Default: every password session. A profile is a name, not a credential:
# anyone with the password can sign in as an admin by typing that name, so this
# keeps the button from friends who should not press it, not from someone
# determined.
ADMIN_PROFILES=
# Content-Security-Policy. Production sends the full policy report-only (each
# violation is logged once as a "[csp]" line) until this is 1. Watch the logs
# for a few days after deploying, then enforce.
CSP_ENFORCE=

# ---- Quotas (all optional; defaults shown; 0 turns that kind of request off) --
# Password sessions: per address per 10 minutes / per day, and everyone together per day.
# CHAT_PASSWORD_PER_10MIN=40
# CHAT_PASSWORD_PER_DAY=400
# CHAT_PASSWORD_GLOBAL_PER_DAY=2000
# Own-key and Puter readers (their own budget, but the server still retrieves for them).
# CHAT_GUEST_PER_MINUTE=6
# CHAT_GUEST_PER_DAY=150
# CHAT_GUEST_IP_PER_MINUTE=15
# CHAT_GUEST_IP_PER_DAY=400
# CHAT_GUEST_GLOBAL_PER_DAY=3000
# Saves of one Puter answer per grant.
# CHAT_COMPLETIONS_PER_GRANT=4
# Sign-in: Gemini-key checks and Puter exchanges, per address and for everyone.
# BYOK_REGISTER_PER_MINUTE=5
# BYOK_REGISTER_PER_DAY=30
# BYOK_REGISTER_GLOBAL_PER_DAY=500
# PUTER_EXCHANGE_PER_MINUTE=10
# PUTER_EXCHANGE_PER_DAY=100
# PUTER_EXCHANGE_GLOBAL_PER_DAY=1000
# Password guessing: per network (IPv4 /24, IPv6 /48) and failures from everyone, per 15 minutes.
# LOGIN_NETWORK_ATTEMPTS_PER_15MIN=30
# LOGIN_GLOBAL_FAILURES_PER_15MIN=50
# Article translations paid by the operator: anyone (per address per hour, all
# together per day) and password sessions.
# PUBLIC_TRANSLATIONS_PER_IP_PER_HOUR=6
# PUBLIC_TRANSLATIONS_PER_DAY=30
# SESSION_TRANSLATIONS_PER_HOUR=60
# SESSION_TRANSLATIONS_PER_DAY=400

# ---- Wiki search (optional; default shown) ---------------------------------
# Full-text searches per address per minute, counted in memory by each process.
# Unlike the quotas above, 0 does not turn search off: it removes the ceiling.
# Requests with no known client address are not counted.
# WIKI_SEARCH_PER_MINUTE=60

# ---- Conversation reads (optional; default shown) ---------------------------
# Opening a saved conversation, per reader and per address per minute, counted
# in memory by each process. Like the search ceiling, 0 removes the ceiling.
# CONVERSATION_READS_PER_MINUTE=60

# ---- Ingest ------------------------------------------------------------------
# Contact string embedded in the MediaWiki User-Agent (required by their policy).
WIKI_CONTACT=you@example.com
# Optional: lets the in-app "re-index" button trigger the GitHub Actions workflow.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Model providers, tried in this order -----------------------------------
# The app needs at least one. Each is optional; a provider with no key is left
# out of the chain rather than tried and failed.
#
# 1. xAI, direct.            https://console.x.ai  (needs credit on the team)
XAI_API_KEY=
# 2. Google Gemini.          https://aistudio.google.com/apikey
#    Free tier: generous daily allowance, 20 requests/minute. Set above.
# 3. Groq.                   https://console.groq.com/keys
#    Free: 200,000 tokens a day, about fifty questions. A different shape of
#    limit from Gemini's twenty a minute, which is why both are worth having.
#    Note: Groq the inference company, not Grok the xAI model.
GROQ_API_KEY=
# 4. OpenRouter.             https://openrouter.ai/keys
#    One key for every model. Its FREE models are not usable here — see the
#    measurements in src/lib/rag/models.ts. Point it at a paid model.
OPENROUTER_API_KEY=

# Model ids, all optional; the defaults are in src/lib/rag/models.ts
# GROK_ANSWER_MODEL=grok-4.20-non-reasoning
# GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
# GEMINI_ANSWER_MODEL=gemini-2.5-flash-lite
# OPENROUTER_ANSWER_MODEL=x-ai/grok-4.3

# Chat deadlines in milliseconds, all optional. Raise them for slow thinking models.
# CHAT_FIRST_TEXT_TIMEOUT_MS=15000     until an answer's first word, per provider
# CHAT_CHUNK_TIMEOUT_MS=20000          between two pieces of an answer
# CHAT_REWRITE_TIMEOUT_MS=6000         one provider's query rewrite
# CHAT_REWRITE_TOTAL_TIMEOUT_MS=10000  the whole rewrite; then the raw question is searched
