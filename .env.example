# ---- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Embeddings ------------------------------------------------------------
# "gemini" (default) uses gemini-embedding-001. Note the free tier allows only
# 1,000 embedding requests per DAY, while indexing this wiki needs several
# thousand — a full ingest needs billing enabled.
# "local" runs multilingual-e5-base on the CPU instead: no key, no quota, and
# the same 768 dimensions, so no migration either. Switching providers forces a
# re-embed; the ingest handles that automatically and refuses to mix vectors.
EMBEDDING_PROVIDER=local

# ---- Database --------------------------------------------------------------
# Production: Neon Postgres connection string (must have the `vector` extension).
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
# Leave empty to fall back to an embedded PGlite database under .data/ (local dev).
DATABASE_URL=

# Overrides the embedded database location (defaults to .data/pglite).
PGLITE_DATA_DIR=

# ---- Auth ------------------------------------------------------------------
# Generate with: pnpm auth:hash "your-password"
APP_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---- Ingest ------------------------------------------------------------------
# Contact string embedded in the MediaWiki User-Agent (required by their policy).
WIKI_CONTACT=you@example.com
# Optional: lets the in-app "re-index" button trigger the GitHub Actions workflow.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Model providers, tried in this order -----------------------------------
# The app needs at least one. Each is optional; a provider with no key is left
# out of the chain rather than tried and failed.
#
# 1. xAI, direct.            https://console.x.ai  (needs credit on the team)
XAI_API_KEY=
# 2. Google Gemini.          https://aistudio.google.com/apikey
#    Free tier: generous daily allowance, 20 requests/minute. Set above.
# 3. Groq.                   https://console.groq.com/keys
#    Free: 200,000 tokens a day, about fifty questions. A different shape of
#    limit from Gemini's twenty a minute, which is why both are worth having.
#    Note: Groq the inference company, not Grok the xAI model.
GROQ_API_KEY=
# 4. OpenRouter.             https://openrouter.ai/keys
#    One key for every model. Its FREE models are not usable here — see the
#    measurements in src/lib/rag/models.ts. Point it at a paid model.
OPENROUTER_API_KEY=

# Model ids, all optional; the defaults are in src/lib/rag/models.ts
# GROK_ANSWER_MODEL=grok-4.20-non-reasoning
# GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
# GEMINI_ANSWER_MODEL=gemini-2.5-flash-lite
# OPENROUTER_ANSWER_MODEL=x-ai/grok-4.3
